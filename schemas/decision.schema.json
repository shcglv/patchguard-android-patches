{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shcglv/patchguard-android-patches/schemas/decision.schema.json",
  "title": "Owner decision",
  "description": "An immutable record of a status or distribution decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "patch",
    "previous_status",
    "new_status",
    "decision_reason",
    "decision_date",
    "approved_by",
    "requires_manual_approval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "patch": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "decision_date": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "requires_manual_approval": {
      "const": true
    },
    "scope": {
      "type": "string",
      "enum": ["DISTRIBUTION", "CATALOG_VISIBILITY", "POLICY_EXCEPTION"]
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
